#include <iostream>
#include <string>
using namespace std;

int BINARIO(string x) {
    int decimal = 0;

    for (int i = 0; i < x.length(); i++) {
        decimal = decimal * 2 + (x[i] - '0');
    }

    return decimal;
}

int main() {
    string x;
    bool valido = true;

    cout << "Ingrese un numero binario: ";
    cin >> x;

    for (int i = 0; i < x.length(); i++) {
        if (x[i] != '0' && x[i] != '1') {
            valido = false;
        }
    }

    if (valido) {
        cout << "Decimal: " << BINARIO(x);
    }
    else {
        cout << "Numero binario incorrecto";
    }

    return 0;
}
