#include <iostream>

using namespace std;

int main() {
    int numero;
    cout << "Ingrese un numero: ";
    cin >> numero;

    int temp = numero;
    if (temp < 0) {
        temp = -temp;
    }

    int contadorPares = 0;
    if (temp == 0) {
        contadorPares = 1;
    } else {
        while (temp > 0) {
            int digito = temp % 10;
            if (digito % 2 == 0) {
                contadorPares++;
            }
            temp /= 10;
        }
    }

    cout << "Cantidad de digitos pares: " << contadorPares << endl;

    return 0;
}
