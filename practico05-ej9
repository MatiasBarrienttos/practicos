#include <iostream>

using namespace std;

int main() {
    int pin;
    cout << "Ingrese un PIN de 4 digitos: ";
    cin >> pin;

    if (pin < 0 || pin > 9999) {
        cout << "PIN INVALIDO: Debe ser de exactamente 4 digitos." << endl;
        return 0;
    }

    int d4 = pin % 10;
    int d3 = (pin / 10) % 10;
    int d2 = (pin / 100) % 10;
    int d1 = (pin / 1000) % 10;

    if (d1 == d2 || d2 == d3 || d3 == d4) {
        cout << "PIN INVALIDO: Contiene numeros repetidos consecutivos." << endl;
    } else {
        cout << "PIN VALIDO: Cumple con todas las reglas de seguridad." << endl;
    }

    return 0;
}
