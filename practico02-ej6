#include <iostream>

using namespace std;

int main() {
    // Declaracion de variables
    float num1, num2;

    // Entrada de datos
    cout << "Ingrese el primer numero: ";
    cin >> num1;

    cout << "Ingrese el segundo numero: ";
    cin >> num2;

    // Proceso y Salida
    if (num1 > num2) {
        cout << "El numero mayor es: " << num1 << endl;
    } else if (num2 > num1) {
        cout << "El numero mayor es: " << num2 << endl;
    } else {
        cout << "Ambos numeros son iguales." << endl;
    }

    return 0;
}
