#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    double C, T, M, G;
    int N;

    cout << "--- Inversion con Capitalizacion Mensual ---" << endl;
    cout << "Ingrese el capital inicial (C): ";
    cin >> C;
    cout << "Ingrese la tasa de interes anual en % (T): ";
    cin >> T;
    cout << "Ingrese el plazo en anos (N): ";
    cin >> N;

    
    M = C * pow(1 + (T / 12.0 / 100.0), N * 12);
    G = M - C;

    cout << fixed << setprecision(2);
    cout << "\nResultados:" << endl;
    cout << "Monto acumulado (M): " << M << endl;
    cout << "Ganancia neta (G): " << G << endl;

    return 0;
}
