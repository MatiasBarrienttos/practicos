#include <iostream>
#include <iomanip> 
#include <thread>  
#include <chrono>  

using namespace std;

int main() {
    int h = 0, m = 0, s = 0;
    
    cout << "Iniciando reloj digital (Presione Ctrl+C para detener)..." << endl;
    
    while (true) {
       
        cout << "\r" 
             << setfill('0') << setw(2) << h << ":"
             << setfill('0') << setw(2) << m << ":"
             << setfill('0') << setw(2) << s << flush;
             
        s++;
        if (s == 60) {
            s = 0;
            m++;
        }
        if (m == 60) {
            m = 0;
            h++;
        }
        if (h == 24) {
            h = 0; // Reinicia el día
        }
     
        this_thread::sleep_for(chrono::seconds(1));
    }
    
    return 0;
}
