#include <iostream>

using namespace std;

int main() {
    int numero;
    cout << "Ingrese un numero para verificar si es Octal (Base 8): ";
    cin >> numero;

    int temp = numero;
    if (temp < 0) {
        temp = -temp;
    }

    bool esOctalValido = true;

    if (temp == 0) {
        esOctalValido = true;
    } else {
        while (temp > 0) {
            int digito = temp % 10;
            if (digito >= 8) {
                esOctalValido = false;
                break;
            }
            temp /= 10;
        }
    }

    if (esOctalValido) {
        cout << "El numero es VALIDO en base 8." << endl;
    } else {
        cout << "El numero es INVALIDO en base 8 (contiene digitos 8 o 9)." << endl;
    }

    return 0;
}
