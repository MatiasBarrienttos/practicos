#include <iostream>
using namespace std;

bool BISIESTO(int a) {
    return (a % 4 == 0 && a % 100 != 0) || (a % 400 == 0);
}

bool FECHA(int d, int m, int a) {
    if (a < 1 || m < 1 || m > 12 || d < 1)
        return false;

    int dias[] = {31, 28, 31, 30, 31, 30,
                  31, 31, 30, 31, 30, 31};

    if (BISIESTO(a))
        dias[1] = 29;

    return d <= dias[m - 1];
}

long long DIAS(int d, int m, int a) {
    long long total = 0;

    for (int i = 1; i < a; i++) {
        if (BISIESTO(i))
            total = total + 366;
        else
            total = total + 365;
    }

    int dias[] = {31, 28, 31, 30, 31, 30,
                  31, 31, 30, 31, 30, 31};

    if (BISIESTO(a))
        dias[1] = 29;

    for (int i = 0; i < m - 1; i++) {
        total = total + dias[i];
    }

    total = total + d;

    return total;
}

int main() {
    int d1, m1, a1;
    int d2, m2, a2;

    cout << "PRIMERA FECHA" << endl;

    cout << "Ingrese dia: ";
    cin >> d1;

    cout << "Ingrese mes: ";
    cin >> m1;

    cout << "Ingrese anio: ";
    cin >> a1;

    cout << endl << "SEGUNDA FECHA" << endl;

    cout << "Ingrese dia: ";
    cin >> d2;

    cout << "Ingrese mes: ";
    cin >> m2;

    cout << "Ingrese anio: ";
    cin >> a2;

    if (FECHA(d1, m1, a1) && FECHA(d2, m2, a2)) {
        long long f1 = DIAS(d1, m1, a1);
        long long f2 = DIAS(d2, m2, a2);

        long long diferencia = f1 - f2;

        if (diferencia < 0)
            diferencia = -diferencia;

        cout << "Dias transcurridos: " << diferencia;
    }
    else {
        cout << "Una de las fechas no es valida";
    }

    return 0;
}
