#include <iostream>
using namespace std;

int main() {
    int N, divisores = 0;
    cout << "Ingrese un numero entero N: ";
    cin >> N;
    
    if (N <= 1) {
        cout << "El numero " << N << " no es primo." << endl;
        return 0;
    }
    
    for (int i = 1; i <= N; i++) {
        if (N % i == 0) {
            divisores++;
        }
    }
    
    if (divisores == 2) {
        cout << "El numero " << N << " es PRIMO." << endl;
    } else {
        cout << "El numero " << N << " NO es primo." << endl;
    }
    
    return 0;
}
