#include <iostream>
#include <cmath>
using namespace std;

int main() {
    float a, b, c;
    cout << "Ingrese los valores de a, b y c: ";
    cin >> a >> b >> c;

    float discriminante = (b * b) - (4 * a * c);

    if (discriminante >= 0) {
        float x1 = (-b + sqrt(discriminante)) / (2 * a);
        float x2 = (-b - sqrt(discriminante)) / (2 * a);
        cout << "Las soluciones son: x1 = " << x1 << " y x2 = " << x2 << endl;
    } else {
        cout << "La ecuacion no tiene soluciones reales." << endl;
    }

    return 0;
}
