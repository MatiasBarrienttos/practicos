#include <iostream>

using namespace std;

int main() {
    int numero;
    cout << "Ingrese un numero: ";
    cin >> numero;

    if (numero < 0) {
        cout << "Por favor ingrese un numero positivo." << endl;
        return 0;
    }

    int temp = numero;
    int complemento = 0;
    int multiplicador = 1;

    if (temp == 0) {
        complemento = 9;
    } else {
        while (temp > 0) {
            int digito = temp % 10;
            int compDigito = 9 - digito;
            complemento = (compDigito * multiplicador) + complemento;
            multiplicador *= 10;
            temp /= 10;
        }
    }

    cout << "El complemento a 9 es: " << complemento << endl;

    return 0;
}
