#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double X, S = 0;
    int n, signo = 1;
    cout << "Ingrese el valor de X: ";
    cin >> X;
    cout << "Ingrese el valor impar de n: ";
    cin >> n;
    
    for (int i = 1; i <= n; i += 2) {
        double fact = 1;
        for (int j = 1; j <= i; j++) {
            fact *= j;
        }
        
        S += signo * (pow(X, i) / fact);
        signo *= -1; 
    }
    
    cout << "El resultado de la serie es: " << S << endl;
    return 0;
}
