#include <iostream>
using namespace std;

void ROMANO(int n) {
    int valores[] = {1000, 900, 500, 400, 100, 90,
    50, 40, 10, 9, 5, 4, 1};

    string simbolos[] = {"M", "CM", "D", "CD", "C", "XC",
    "L", "XL", "X", "IX", "V", "IV", "I"};

    for (int i = 0; i < 13; i++) {
        while (n >= valores[i]) {
            cout << simbolos[i];
            n = n - valores[i];
        }
    }
}

int main() {
    int n;

    cout << "Ingrese un numero: ";
    cin >> n;

    if (n >= 1 && n <= 3999) {
        cout << "Numero romano: ";
        ROMANO(n);
    }
    else {
        cout << "Numero fuera de rango";
    }

    return 0;
}
