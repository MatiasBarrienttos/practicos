#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double x, S = 0;
    int n;
    cout << "Ingrese la base real x: ";
    cin >> x;
    cout << "Ingrese el exponente limite n: ";
    cin >> n;
    
    for (int i = 1; i <= n; i++) {
        S += pow(x, i);
    }
    
    cout << "El resultado de la serie es: " << S << endl;
    return 0;
}
