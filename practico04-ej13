#include <iostream>
using namespace std;

int main() {
    cout << "--- TABLA DE SUMAR (1 al 10) ---" << endl;
    for (int i = 1; i <= 10; i++) {
        cout << "\nTabla del " << i << ":" << endl;
        for (int j = 1; j <= 10; j++) {
            cout << i << " + " << j << " = " << (i + j) << endl;
        }
    }
    return 0;
}
