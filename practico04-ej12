#include <iostream>
using namespace std;

int main() {
    int A, B;
    cout << "Ingrese el valor de A: ";
    cin >> A;
    cout << "Ingrese el valor de B: ";
    cin >> B;
    
    int a = A, b = B, temp;
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }
    int mcd = a;
    int mcm = (A * B) / mcd;
    
    cout << "El MCM es: " << mcm << endl;
    return 0;
}
