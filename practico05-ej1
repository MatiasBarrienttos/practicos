#include <iostream>

using namespace std;

int main() {
    int numero;
    cout << "Ingrese un numero: ";
    cin >> numero;

    int temp = numero;
    if (temp < 0) {
        temp = -temp;
    }

    int suma = 0;
    if (temp == 0) {
        suma = 0;
    } else {
        while (temp > 0) {
            int digito = temp % 10;
            suma += digito;
            temp /= 10;
        }
    }

    cout << "La suma de los digitos es: " << suma << endl;

    return 0;
}
